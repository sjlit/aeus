package config

import (
	"log"
	"os"
	"strconv"
)

// Config holds the runnable admin starter settings. Values are read
// from the environment; .env.example documents every key.
type Config struct {
	AppName       string
	HTTPAddr      string
	DBDSN         string
	JWTSecret     string
	AdminUser     string
	AdminPassword string
	WebRoot       string
	Debug         bool
	MultiTenant   bool
	AutoMigrate   bool
	SeedOnStart   bool
}

// Load applies development defaults and warns when a production
// secret is still at its sample value.
func Load() Config {
	cfg := Config{
		AppName:       env("APP_NAME", "__AEUS_NAME__"),
		HTTPAddr:      env("HTTP_ADDR", ":8080"),
		DBDSN:         env("DB_DSN", "./data/aeus.db"),
		JWTSecret:     env("JWT_SECRET", "change-me"),
		AdminUser:     env("ADMIN_USER", "admin"),
		AdminPassword: env("ADMIN_PASSWORD", "Admin123"),
		WebRoot:       env("WEB_ROOT", "./web/dist"),
		Debug:         envBool("DEBUG", true),
		MultiTenant:   envBool("MULTI_TENANT", false),
		AutoMigrate:   envBool("AUTO_MIGRATE", true),
		SeedOnStart:   envBool("SEED_ON_START", true),
	}
	if cfg.JWTSecret == "change-me" {
		log.Print("warning: JWT_SECRET is the development default; set a strong secret before exposing this service")
	}
	if cfg.AdminPassword == "Admin123" {
		log.Print("warning: ADMIN_PASSWORD is the development default; change it after the first login")
	}
	return cfg
}

func env(key, fallback string) string {
	if value := os.Getenv(key); value != "" {
		return value
	}
	return fallback
}

func envBool(key string, fallback bool) bool {
	value := os.Getenv(key)
	if value == "" {
		return fallback
	}
	parsed, err := strconv.ParseBool(value)
	if err != nil {
		return fallback
	}
	return parsed
}
