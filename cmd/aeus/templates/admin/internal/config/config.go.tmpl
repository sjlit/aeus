package config

import (
	"fmt"
	"strings"
)

// Config is grouped by concern so the YAML file and Go code read the
// same way. Environment variables override values loaded from the file;
// see load.go and .env.example.
type Config struct {
	App       AppConfig       `yaml:"app"`
	Server    ServerConfig    `yaml:"server"`
	Database  DatabaseConfig  `yaml:"database"`
	Auth      AuthConfig      `yaml:"auth"`
	Bootstrap BootstrapConfig `yaml:"bootstrap"`
	Log       LogConfig       `yaml:"log"`
}

type AppConfig struct {
	Name        string `yaml:"name"`
	Debug       bool   `yaml:"debug"`
	MultiTenant bool   `yaml:"multi_tenant"`
}

type ServerConfig struct {
	HTTPAddr string     `yaml:"http_addr"`
	WebRoot  string     `yaml:"web_root"`
	CORS     CORSConfig `yaml:"cors"`
}

type CORSConfig struct {
	Origins          []string `yaml:"origins"`
	AllowCredentials bool     `yaml:"allow_credentials"`
}

type DatabaseConfig struct {
	DSN string `yaml:"dsn"`
}

type AuthConfig struct {
	JWTSecret     string `yaml:"jwt_secret"`
	AdminUser     string `yaml:"admin_user"`
	AdminPassword string `yaml:"admin_password"`
}

type BootstrapConfig struct {
	AutoMigrate bool `yaml:"auto_migrate"`
	SeedOnStart bool `yaml:"seed_on_start"`
}

type LogConfig struct {
	Level  string `yaml:"level"`  // debug | info | warn | error
	Format string `yaml:"format"` // text | json
	Output string `yaml:"output"` // stdout | stderr | file path
}

// Default returns the development baseline. Load applies the optional
// config file and environment on top of it.
func Default() Config {
	return Config{
		App: AppConfig{
			Name:  "__AEUS_NAME__",
			Debug: true,
		},
		Server: ServerConfig{
			HTTPAddr: ":8080",
			WebRoot:  "./web/dist",
		},
		Database: DatabaseConfig{
			DSN: "./data/aeus.db",
		},
		Auth: AuthConfig{
			JWTSecret:     "change-me",
			AdminUser:     "admin",
			AdminPassword: "Admin123",
		},
		Bootstrap: BootstrapConfig{
			AutoMigrate: true,
			SeedOnStart: true,
		},
		Log: LogConfig{
			Level:  "info",
			Format: "text",
			Output: "stdout",
		},
	}
}

// Validate fails fast on values the process cannot meaningfully use.
func (c Config) Validate() error {
	if strings.TrimSpace(c.App.Name) == "" {
		return fmt.Errorf("app.name is empty")
	}
	if strings.TrimSpace(c.Server.HTTPAddr) == "" {
		return fmt.Errorf("server.http_addr is empty")
	}
	if strings.TrimSpace(c.Database.DSN) == "" {
		return fmt.Errorf("database.dsn is empty")
	}
	switch strings.ToLower(strings.TrimSpace(c.Log.Level)) {
	case "debug", "info", "warn", "error":
	default:
		return fmt.Errorf("log.level %q is invalid (want debug, info, warn or error)", c.Log.Level)
	}
	switch strings.ToLower(strings.TrimSpace(c.Log.Format)) {
	case "text", "json":
	default:
		return fmt.Errorf("log.format %q is invalid (want text or json)", c.Log.Format)
	}
	if strings.TrimSpace(c.Log.Output) == "" {
		return fmt.Errorf("log.output is empty")
	}
	return nil
}

// Warnings reports development defaults that must not reach production.
// Callers log them after the configured logger is initialized.
func (c Config) Warnings() []string {
	var warnings []string
	if c.Auth.JWTSecret == "change-me" {
		warnings = append(warnings, "JWT_SECRET is the development default; set a strong secret before exposing this service")
	}
	if c.Auth.AdminPassword == "Admin123" {
		warnings = append(warnings, "ADMIN_PASSWORD is the development default; change it after the first login")
	}
	return warnings
}
