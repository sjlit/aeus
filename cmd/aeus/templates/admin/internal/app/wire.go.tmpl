package app

import (
	"context"
	"fmt"
	"net/http"
	"os"

	"github.com/golang-jwt/jwt/v5"
	"github.com/sjlit/aeus/admin"
	adminAuth "github.com/sjlit/aeus/admin/auth"
	"github.com/sjlit/aeus/admin/pb"
	"github.com/sjlit/aeus/admin/service"
	memcache "github.com/sjlit/aeus/infra/cache/memory"
	mw "github.com/sjlit/aeus/middleware/auth"

	"__AEUS_MODULE__/internal/gen"
)

func (l *Loader) wire(ctx context.Context) error {
	s := l.scope
	if s.admin == nil {
		return fmt.Errorf("app: admin server was not initialized")
	}
	if err := s.admin.Setup(ctx); err != nil {
		return fmt.Errorf("admin setup: %w", err)
	}

	secret := []byte(s.cfg.Auth.JWTSecret)
	httpSrv := s.http
	db := s.db

	// Proto-generated business models, module menus and route policies.
	// `aeus gen` rewrites internal/gen/wiring.go; the checked-in file is
	// a no-op until the first proto resource is generated.
	if err := gen.Register(s.admin, db); err != nil {
		return fmt.Errorf("generated resources: %w", err)
	}

	pb.RegisterAuthServiceRouter(httpSrv, service.NewAuthService(
		service.WithAuthServiceDB(db),
		service.WithAuthSecret(s.cfg.Auth.JWTSecret),
	))

	sharedCache := memcache.NewCache()
	// RateLimit sits before JWT so login spam cannot burn bcrypt
	// cycles. Tune Capacity/Refill for production.
	httpSrv.Use(mw.RateLimit(mw.RateLimitOpts{
		Path:     "/auth/login",
		Keys:     []string{"login:ip:{ip}"},
		Capacity: 5,
		Refill:   1.0 / 60,
	}))
	httpSrv.Use(mw.JWT(
		func(*jwt.Token) (any, error) { return secret, nil },
		mw.WithClaims(adminAuth.Claims{}),
		mw.WithPermissionChecker(admin.NewPermissionChecker(db, admin.WithCheckerCache(sharedCache))),
		mw.WithAllow(
			"/auth/login",
			"/auth/refresh-token",
			"/auth/logout",
			"/health",
			"/ready",
			// The SPA is served by this binary; its shell and assets
			// must be reachable before the user signs in.
			"/",
			"/index.html",
			"/favicon.ico",
			"/assets/*",
		),
	))

	pb.RegisterUserServiceRouter(httpSrv, service.NewUserService(
		service.WithUserServiceDB(db),
		service.WithUserServiceCache(sharedCache),
	))
	pb.RegisterRoleServiceRouter(httpSrv, service.NewRoleService(
		service.WithRoleServiceDB(db),
		service.WithRoleServiceCache(sharedCache),
	))
	pb.RegisterPermissionServiceRouter(httpSrv, service.NewPermissionService(
		service.WithPermissionServiceDB(db),
	))
	pb.RegisterMenuServiceRouter(httpSrv, service.NewMenuService(
		service.WithMenuServiceDB(db),
		service.WithMenuServiceCache(sharedCache),
	))
	// TenantService is super-only at the service layer; registering it
	// keeps the admin RPC surface complete even though the bundled web
	// uses the generic REST resource for the tenant page.
	pb.RegisterTenantServiceRouter(httpSrv, service.NewTenantService(
		service.WithTenantServiceDB(db),
	))

	// Seed is idempotent, but multi-instance production deployments
	// should set bootstrap.seed_on_start=false and run cmd/seed as a one-off Job.
	if s.cfg.Bootstrap.SeedOnStart {
		if err := admin.Seed(db, s.cfg.Auth.AdminUser, s.cfg.Auth.AdminPassword); err != nil {
			return fmt.Errorf("seed admin: %w", err)
		}
	}

	if s.cfg.Server.WebRoot != "" {
		if info, err := os.Stat(s.cfg.Server.WebRoot); err == nil && info.IsDir() {
			httpSrv.Webroot("/", true, http.Dir(s.cfg.Server.WebRoot))
		} else {
			s.log.Warnf(ctx, "web root %s not found; serving API only (run `make web`)", s.cfg.Server.WebRoot)
		}
	}
	return nil
}
