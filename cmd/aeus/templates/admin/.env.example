# Environment variables override configs/config.yaml.
APP_NAME=__AEUS_NAME__
HTTP_ADDR=:8080
DB_DSN=./data/aeus.db
JWT_SECRET=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=Admin123
WEB_ROOT=./web/dist
DEBUG=true
# Enables GORM tenant scoping plus the tenant-management menu/REST resource.
MULTI_TENANT=false
# Development default. Run `make migrate` first, then set this to false
# in production so a boot does not alter the schema.
AUTO_MIGRATE=true
# Set to false in multi-instance production and run `make seed` as a Job.
SEED_ON_START=true
# Comma-separated browser origins allowed to call the API, e.g.
# https://admin.example.com. Empty means same-origin only (the default,
# since the Go binary serves the built SPA).
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
# text | json
LOG_FORMAT=text
# debug | info | warn | error
LOG_LEVEL=info
# stdout | stderr | a file path (no rotation; use external logrotate)
LOG_OUTPUT=stdout
