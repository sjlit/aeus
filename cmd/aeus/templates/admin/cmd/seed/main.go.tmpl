package main

import (
	"context"
	"flag"
	"fmt"
	"os"

	"github.com/sjlit/aeus/admin"
	ghttp "github.com/sjlit/aeus/transport/http"

	"__AEUS_MODULE__/internal/config"
	"__AEUS_MODULE__/internal/gen"
	"__AEUS_MODULE__/internal/logging"
	"__AEUS_MODULE__/internal/store"
)

var configFlag = flag.String("config", "", "config file (default: configs/config.yaml when present)")

func main() {
	flag.Parse()
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, "seed:", err)
		os.Exit(1)
	}
}

func run() error {
	cfg, err := config.Load(*configFlag)
	if err != nil {
		return err
	}
	lg, closer, err := logging.New(cfg.Log)
	if err != nil {
		return err
	}
	if closer != nil {
		defer closer.Close()
	}

	ctx := context.Background()
	for _, warning := range cfg.Warnings() {
		lg.Warnf(ctx, "%s", warning)
	}
	db, err := store.Open(cfg.Database.DSN, lg, cfg.Log.Level == "debug")
	if err != nil {
		return err
	}

	// Setup derives the menu and permission catalog from the registered
	// models. Run it against a throwaway router so `make seed` works as
	// a standalone production Job after `make migrate`.
	seedOpts := []admin.Option{
		admin.WithDB(db),
		admin.WithRouter(ghttp.New()),
		admin.WithLogger(lg),
		admin.WithAutoMigrate(cfg.Bootstrap.AutoMigrate),
	}
	if cfg.App.MultiTenant {
		seedOpts = append(seedOpts, admin.WithMultiTenant(true))
	}
	srv := admin.New(seedOpts...)
	if err := srv.Setup(ctx); err != nil {
		return err
	}
	if err := gen.Register(srv, db); err != nil {
		return err
	}
	if err := admin.Seed(db, cfg.Auth.AdminUser, cfg.Auth.AdminPassword); err != nil {
		return err
	}
	lg.Infof(ctx, "seeded admin user %q", cfg.Auth.AdminUser)
	return nil
}
