package main

import (
	"context"
	"flag"
	"fmt"
	"os"

	"__AEUS_MODULE__/internal/config"
	"__AEUS_MODULE__/internal/gen"
	"__AEUS_MODULE__/internal/logging"
	"__AEUS_MODULE__/internal/store"
)

var configFlag = flag.String("config", "", "config file (default: configs/config.yaml when present)")

// migrate applies the schema explicitly so production can run with
// bootstrap.auto_migrate=false.
func main() {
	flag.Parse()
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, "migrate:", err)
		os.Exit(1)
	}
}

func run() error {
	cfg, err := config.Load(*configFlag)
	if err != nil {
		return err
	}
	lg, closer, err := logging.New(cfg.Log)
	if err != nil {
		return err
	}
	if closer != nil {
		defer closer.Close()
	}

	ctx := context.Background()
	for _, warning := range cfg.Warnings() {
		lg.Warnf(ctx, "%s", warning)
	}
	db, err := store.Open(cfg.Database.DSN, lg, cfg.Log.Level == "debug")
	if err != nil {
		return err
	}
	if err := store.AutoMigrateCatalog(db); err != nil {
		return err
	}
	if err := gen.Migrate(db); err != nil {
		return err
	}
	lg.Info(ctx, "migration complete")
	return nil
}
